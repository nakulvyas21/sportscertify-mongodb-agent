# =============================================================================
# Sportscertify Social — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Production note: in production (IS_PRODUCTION=true) the sensitive values below
# are resolved from Google Secret Manager FIRST, then env. Secret Manager names
# (kebab-case): mdb-connection-string · voyage-api-key · jwt-signing-key
# Local dev needs no Secret Manager — values come straight from this file.
# =============================================================================

# --- Runtime flags -----------------------------------------------------------
# IS_PRODUCTION=true enables Secret Manager + HSTS + strict config.
IS_PRODUCTION="false"
# IS_BUILD_PHASE=true short-circuits Secret Manager during Docker/Cloud Build.
IS_BUILD_PHASE="false"
# GCP project that owns the secrets.
GCP_PROJECT_ID="your-gcp-project"

# --- MongoDB Atlas -----------------------------------------------------------
# Secret Manager name in prod: mdb-connection-string
MDB_MCP_CONNECTION_STRING="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MDB_DATABASE_NAME="sportscertify_social"

# MCP read-only safety flag — the agent can never mutate the cluster.
MDB_MCP_READ_ONLY="true"

# --- Voyage AI (voyage-4-large embeddings, 1024 dims) ------------------------
# Secret Manager name in prod: voyage-api-key
VOYAGE_API_KEY="pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VOYAGE_MODEL="voyage-4-large"
VOYAGE_EMBED_DIM="1024"

# --- Gemini via Vertex AI (NO API key) ---------------------------------------
# Authenticates through Vertex AI using the service account / Application Default
# Credentials. Locally, run `gcloud auth application-default login` once; on
# Cloud Run the runtime service account is used automatically (grant it
# roles/aiplatform.user).
GOOGLE_CLOUD_PROJECT="your-gcp-project"
GOOGLE_CLOUD_LOCATION="us-central1"
AI_MODEL="gemini-2.5-flash"
# Optional: path to a service-account JSON key for local use (otherwise ADC).
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/sa-key.json"

# --- Auth (JWT) --------------------------------------------------------------
# Secret Manager name in prod: jwt-signing-key. Generate: openssl rand -hex 32
JWT_SIGNING_KEY="change-me-to-a-long-random-string-min-16-chars"
JWT_ACCESS_TTL_SECONDS="86400"
JWT_REFRESH_TTL_SECONDS="604800"

# --- HTTP / security ---------------------------------------------------------
PORT="8080"
VECTOR_INDEX_NAME="posts_content_vector_index"
# CORS allowlist (comma-separated). No wildcard in prod.
CORS_ALLOWED_ORIGINS="http://localhost:4200,http://localhost:4000"
